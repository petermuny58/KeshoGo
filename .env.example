# Copy this file to .env and fill in your real Neon project values.
# Both strings come from the Neon Console — the pooled one has "-pooler" in
# the hostname, the direct one doesn't. Both connect to the same database.

# Pooled connection — used by the running app at runtime (src/db.ts).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct (unpooled) connection — used for migrations and seeding
# (prisma.config.ts, prisma/seed.ts). PgBouncer's transaction-pooling mode
# breaks prepared statements and long-running transactions, which is why
# these two operations specifically need the unpooled string.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxxxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

NODE_ENV="development"

# Clerk — from the Clerk Dashboard's API Keys page.
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
# From Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
# Required for /webhooks/clerk to verify requests are actually from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxx"

# Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS="http://localhost:5173"

PORT="8787"

# Frontend (Vite) — same Clerk publishable key as the backend secret's app.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"

# Cloudflare R2 — optional for local dev (uploads fall back to placeholder URLs).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Set to "true" when live MoMo/Airtel disbursement is enabled.
PAYOUTS_ENABLED="false"
